generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm]
}

model Usuario {
  id_usuario        Int                    @id @default(autoincrement())
  nombre            String
  email             String                 @unique
  password_hash     String
  refresh_token_hash String?               @map("refresh_token_hash")
  rol               String                 @default("vendedor")
  avatar_url        String?                @map("avatar_url")
  activo            Boolean                @default(true)
  created_at        DateTime               @default(now())
  updated_at        DateTime               @updatedAt
  deleted_at        DateTime?
  cotizaciones      Cotizacion[]
  historialPrecios  HistorialPrecios[]
  movimientos       InventarioMovimiento[]
  cotizacionPagos   CotizacionPago[]       @relation("CotizacionPagoUsuario")
  permisos          UsuarioPermiso[]

  @@index([nombre(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([deleted_at, created_at])
  @@map("usuarios")
}

model UsuarioPermiso {
  id_usuario Int
  modulo     PermisoModulo
  nivel      NivelPermiso
  usuario    Usuario @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade)

  @@id([id_usuario, modulo])
  @@map("usuario_permisos")
}

model Rol {
  id_rol     Int           @id @default(autoincrement())
  nombre     String        @unique
  codigo     String        @unique
  es_sistema Boolean       @default(false)
  orden      Int           @default(0)
  activo     Boolean       @default(true)
  created_at DateTime      @default(now())
  permisos   RolPermiso[]

  @@map("roles")
}

model RolPermiso {
  id_rol  Int
  modulo  PermisoModulo
  nivel   NivelPermiso
  rol     Rol @relation(fields: [id_rol], references: [id_rol], onDelete: Cascade)

  @@id([id_rol, modulo])
  @@map("rol_permisos")
}

model Categoria {
  id_categoria     Int        @id @default(autoincrement())
  nombre_categoria String     @map("nombre_categoria")
  productos        Producto[]

  @@map("categorias")
}

model Producto {
  id_producto        Int                    @id @default(autoincrement())
  codigo             String                 @unique
  descripcion        String
  tipo_flor          String?
  material           String?
  composicion        String?
  presentacion       String?
  follaje            String?
  numero_cabezas     Int?
  tamano             String?
  colores_surtido    Json?                  @map("colores_surtido")
  foto_url           String?
  activo             Boolean                @default(true)
  stock_principal    Int                    @default(0)
  stock_total        Int                    @default(0)
  stock_minimo       Int                    @default(10)
  unidades_por_caja  Int                    @default(1)
  id_categoria       Int?
  created_at         DateTime               @default(now())
  updated_at         DateTime               @updatedAt
  deleted_at         DateTime?
  alertas_stock      alertas_stock[]
  cotizacion_detalle CotizacionDetalle[]
  historial_precios  HistorialPrecios[]
  movimientos        InventarioMovimiento[]
  precios_actuales   PreciosActuales?
  categoria          Categoria?             @relation(fields: [id_categoria], references: [id_categoria])
  stock_actual       StockActual[]

  @@index([descripcion(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([codigo(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([deleted_at, created_at])
  @@index([id_categoria])
  @@map("productos")
}

model PreciosActuales {
  id_producto          Int      @id
  costo_normal         Decimal  @default(0.00) @db.Decimal(10, 2)
  precio_unidad_normal Decimal  @default(0.00) @db.Decimal(10, 2)
  precio_docena_normal Decimal  @default(0.00) @db.Decimal(10, 2)
  precio_mayor_normal  Decimal  @default(0.00) @db.Decimal(10, 2)
  costo_distribuidor   Decimal  @default(0.00) @db.Decimal(10, 2)
  precio_unidad_dist   Decimal  @default(0.00) @db.Decimal(10, 2)
  precio_docena_dist   Decimal  @default(0.00) @db.Decimal(10, 2)
  precio_mayor_dist    Decimal  @default(0.00) @db.Decimal(10, 2)
  updated_at           DateTime @updatedAt
  producto             Producto @relation(fields: [id_producto], references: [id_producto], onDelete: Cascade)

  @@map("precios_actuales")
}

model HistorialPrecios {
  id_historial     Int      @id @default(autoincrement())
  id_producto      Int
  id_usuario       Int?
  campo_modificado String
  valor_anterior   Decimal  @db.Decimal(10, 2)
  valor_nuevo      Decimal  @db.Decimal(10, 2)
  fecha_cambio     DateTime @default(now())
  producto         Producto @relation(fields: [id_producto], references: [id_producto], onDelete: Cascade)
  usuario          Usuario? @relation(fields: [id_usuario], references: [id_usuario])

  @@index([id_producto, fecha_cambio])
  @@index([fecha_cambio])
  @@index([id_usuario])
  @@map("historial_precios")
}

model Cliente {
  id_cliente         Int            @id @default(autoincrement())
  nombre             String
  telefono           String?
  email              String?
  ruc_dni            String?
  tipo               TipoPrecio     @default(normal)
  created_at         DateTime       @default(now())
  diasCreditoDefecto Int?
  diasGracia         Int?           @default(0)
  limiteCredito      Decimal?       @default(0) @db.Decimal(12, 2)
  tasaMora           Decimal?       @default(0) @db.Decimal(5, 2)
  updated_at         DateTime       @updatedAt
  deleted_at         DateTime?
  cotizaciones       Cotizacion[]

  @@index([nombre(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([ruc_dni(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([deleted_at, created_at])
  @@map("clientes")
}

model Cotizacion {
  id_cotizacion     Int                 @id @default(autoincrement())
  numero            String              @unique
  id_cliente        Int?
  id_usuario        Int?
  tipo_precio       TipoPrecio          @default(normal)
  subtotal          Decimal             @default(0.00) @db.Decimal(10, 2)
  igv               Decimal             @default(0.00) @db.Decimal(10, 2)
  total             Decimal             @default(0.00) @db.Decimal(10, 2)
  observaciones     String?
  incluye_carreta   Boolean             @default(true)
  costo_carreta     Decimal             @default(15.00) @db.Decimal(10, 2)
  estado            EstadoCotizacion    @default(borrador)
  tiempo_inicio     DateTime            @default(now())
  tiempo_fin        DateTime?
  created_at        DateTime            @default(now())
  fecha_vencimiento DateTime?
  pdf_key           String?
  pdf_hash          String?
  pdf_generado_en   DateTime?
  detalle           CotizacionDetalle[]
  pagos             CotizacionPago[]
  cliente           Cliente?            @relation(fields: [id_cliente], references: [id_cliente])
  usuario           Usuario?            @relation(fields: [id_usuario], references: [id_usuario])

  @@index([created_at])
  @@index([estado, created_at])
  @@index([id_cliente, created_at])
  @@index([id_usuario])
  @@index([fecha_vencimiento, estado])
  @@map("cotizaciones")
}

model CotizacionDetalle {
  id_detalle      Int        @id @default(autoincrement())
  id_cotizacion   Int
  id_producto     Int
  tipo_venta      TipoVenta
  cantidad        Int
  color_notas     String?
  precio_unitario Decimal    @db.Decimal(10, 2)
  subtotal        Decimal    @db.Decimal(10, 2)
  es_sugerido_ia  Boolean    @default(false)
  cotizacion      Cotizacion @relation(fields: [id_cotizacion], references: [id_cotizacion], onDelete: Cascade)
  producto        Producto   @relation(fields: [id_producto], references: [id_producto])

  @@index([id_cotizacion])
  @@index([id_producto])
  @@map("cotizacion_detalle")
}

model CotizacionPago {
  id_pago       Int           @id @default(autoincrement())
  id_cotizacion Int
  monto         Decimal       @db.Decimal(12, 2)
  metodo_pago   MetodoPago
  referencia    String?
  id_usuario    Int?
  created_at    DateTime      @default(now())
  cotizacion    Cotizacion    @relation(fields: [id_cotizacion], references: [id_cotizacion], onDelete: Cascade)
  usuario       Usuario?      @relation("CotizacionPagoUsuario", fields: [id_usuario], references: [id_usuario])

  @@index([id_cotizacion])
  @@map("cotizacion_pagos")
}

model Almacen {
  id_almacen    Int                    @id @default(autoincrement())
  codigo        String                 @unique
  nombre        String
  ubicacion     String?
  activo        Boolean                @default(true)
  alertas_stock alertas_stock[]
  movimientos   InventarioMovimiento[]
  stock_actual  StockActual[]

  @@map("almacenes")
}

model StockActual {
  id_stock    Int      @id @default(autoincrement())
  id_producto Int
  id_almacen  Int
  cantidad    Int      @default(0)
  updated_at  DateTime @updatedAt
  almacen     Almacen  @relation(fields: [id_almacen], references: [id_almacen], onDelete: Cascade)
  producto    Producto @relation(fields: [id_producto], references: [id_producto], onDelete: Cascade)

  @@unique([id_producto, id_almacen])
  @@index([id_almacen])
  @@map("stock_actual")
}

model InventarioMovimiento {
  id_movimiento   Int              @id @default(autoincrement())
  id_producto     Int
  id_almacen      Int
  tipo            TipoMovimiento
  origen          OrigenMovimiento
  cantidad        Int
  stock_anterior  Int
  stock_posterior Int
  costo_unitario  Decimal?         @db.Decimal(10, 2)
  id_referencia   Int?
  tipo_referencia String?
  observaciones   String?
  id_usuario      Int?
  created_at      DateTime         @default(now())
  almacen         Almacen          @relation(fields: [id_almacen], references: [id_almacen], onDelete: Cascade)
  producto        Producto         @relation(fields: [id_producto], references: [id_producto], onDelete: Cascade)
  usuario         Usuario?         @relation(fields: [id_usuario], references: [id_usuario])

  @@index([id_almacen, created_at])
  @@index([id_producto, created_at])
  @@index([tipo_referencia, id_referencia])
  @@index([created_at])
  @@index([id_usuario])
  @@map("inventario_movimientos")
}

model IaInteracciones {
  id_interaccion      Int      @id @default(autoincrement())
  id_producto         Int?     @map("id_producto")
  id_producto_sugerido Int?    @map("id_producto_sugerido")
  tipo_sugerencia     String?  @map("tipo_sugerencia")
  accion_usuario      String?  @map("accion_usuario")
  id_cotizacion       Int?     @map("id_cotizacion")
  id_usuario          Int?     @map("id_usuario")
  prompt              String
  respuesta           String
  created_at          DateTime @default(now())

  @@index([created_at])
  @@index([id_producto])
  @@map("ia_interacciones")
}

model alertas_stock {
  id_alerta     Int          @id @default(autoincrement())
  id_producto   Int
  id_almacen    Int
  stock_actual  Int
  stock_minimo  Int
  estado        AlertaEstado @default(activa)
  created_at    DateTime     @default(now())
  reconocida_at DateTime?
  almacenes     Almacen      @relation(fields: [id_almacen], references: [id_almacen], onDelete: Cascade)
  productos     Producto     @relation(fields: [id_producto], references: [id_producto], onDelete: Cascade)

  @@index([estado])
  @@index([id_producto, id_almacen, estado])
  @@index([estado, created_at])
}

enum PermisoModulo {
  dashboard
  productos
  importacion
  consulta_precios
  cotizaciones
  recomendaciones
  pdf
  usuarios
  cobranza
  ventas
  reportes
  configuracion
}

enum NivelPermiso {
  sin_acceso
  lectura
  edicion
}

enum EstadoCotizacion {
  borrador
  enviada
  parcialmente_pagada
  aprobada
  rechazada
}

enum TipoPrecio {
  normal
  distribuidor
}

enum TipoVenta {
  unidad
  docena
  mayor
}

enum OrigenMovimiento {
  compra
  venta
  devolucion_cliente
  ajuste_fisico
  merma
  transferencia
  cotizacion_aprobada
}

enum AlertaEstado {
  activa
  reconocida
  resuelta
}

model Configuracion {
  clave       String   @id @map("clave")
  valor       String   @map("valor")
  descripcion String?  @map("descripcion")
  updated_at  DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("configuracion")
}

enum MetodoPago {
  efectivo
  transferencia
  tarjeta_credito
  tarjeta_debito
  yape_plin
  mixto
  credito
}

enum TipoMovimiento {
  entrada
  salida
  ajuste
  transferencia
}
