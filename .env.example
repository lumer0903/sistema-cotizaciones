# Database
DATABASE_URL=postgresql://goldcontinent:goldcontinent_dev@localhost:5432/goldcontinent?schema=public

# JWT
JWT_SECRET=your-super-secret-jwt-access-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-jwt-refresh-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# API
PORT=3001
NODE_ENV=development
CLIENT_URL=http://localhost:3000
AI_SERVICE_URL=http://localhost:8000
IA_URL=http://localhost:8000
# Rate limit global por ventana (15 min). Producción: 300; dev/QA: 600+ para
# automatización desde una misma IP (los endpoints de login/refresh siempre 20)
RATE_LIMIT_MAX=600

# IA vía HTTP (opcional)
# AI_USE_MOCK=true   # fuerza respuestas mock sin backend de IA
# AI_HTTP_TIMEOUT=5000

# Almacenamiento local (PDFs/exportaciones). Por defecto: <cwd>/uploads
# STORAGE_PATH=./uploads

# Redis (BullMQ - colas). Dev local: obligatorio para PDFs — `docker compose up -d redis`
# (sin Redis la API responde 503 en los endpoints de PDF en vez de colgarse)
REDIS_HOST=localhost
REDIS_PORT=6379

# Rol del proceso de PDFs (producer=API sólo encola · consumer=worker dedicado · both=un solo proceso)
PDF_ROLE=both
PDF_WORKER_PORT=3002

# MinIO
MINIO_ENABLED=true
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_IA_URL=http://localhost:8000