# Database (PostgreSQL ejecutado nativamente en Windows / Local)
DATABASE_URL=postgresql://goldcontinent:goldcontinent_dev@localhost:5432/goldcontinent?schema=public

# JWT
JWT_SECRET=your-super-secret-jwt-access-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-jwt-refresh-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# API
PORT=3001
NODE_ENV=development
CLIENT_URL=http://localhost:3000
AI_SERVICE_URL=http://localhost:8000
IA_URL=http://localhost:8000
RATE_LIMIT_MAX=600

# ==============================================================================
# ALMACENAMIENTO PERSISTENTE EN DOCKER (MinIO / S3 compatible)
# Docker se usa ÚNICAMENTE como servidor persistente de almacenamiento de archivos.
# Iniciar con: docker compose up -d storage
# ==============================================================================
STORAGE_DRIVER=minio
STORAGE_ENDPOINT=localhost
STORAGE_PORT=9000
STORAGE_BUCKET=goldcontinent-media
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_USE_SSL=false
STORAGE_PUBLIC_URL=http://localhost:9000
STORAGE_PATH=./uploads

# Compatibilidad MinIO legacy
MINIO_ENABLED=true
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Redis (BullMQ - colas)
REDIS_HOST=localhost
REDIS_PORT=6379

# Rol del proceso de PDFs (producer=API sólo encola · consumer=worker dedicado · both=un solo proceso)
PDF_ROLE=both
PDF_WORKER_PORT=3002

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_IA_URL=http://localhost:8000